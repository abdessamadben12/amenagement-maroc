APP_ENV=development
APP_URL=https://amenagement-maroc.com/

# CORS: liste séparée par des virgules. Supporte les wildcards *.exemple.com
CORS_ORIGINS=https://amenagement-maroc/

# CSRF cookie
CSRF_COOKIE_NAME=csrf_token
CSRF_SAMESITE=lax
CSRF_SECURE=false

# Rate limit (fenêtre en secondes, max requêtes)
RATE_WINDOW=900
RATE_MAX=100
SMTP_HOST=mail.amenagement-maroc.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=contact@amenagement-maroc.com
SMTP_PASS=0680082467Ab.

CONTACT_FROM=contact@amenagement-maroc.com
CONTACT_FROM_NAME="Amenagement-maroc Contact"
CONTACT_TO=contact@amenagement-maroc.com
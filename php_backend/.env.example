APP_ENV=development
FRONTEND_DIST=../dist
CORS_ORIGINS=http://localhost:5173

CSRF_COOKIE_NAME=csrf_token
CSRF_SECURE=false
CSRF_SAMESITE=lax

RATE_WINDOW=900
RATE_MAX=100

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_SECURE=tls

CONTACT_FROM=user@example.com
CONTACT_TO=contact@amenagement-maroc.com

# Base de données : sqlite (défaut, aucun serveur) ou mysql
DB_DRIVER=sqlite
# SQLite : chemin du fichier, relatif à php_backend/
DB_PATH=storage/database.sqlite
# MySQL (si DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=amenagement_maroc
DB_USER=root
DB_PASS=
SITE_URL=https://amenagement-maroc.com

# Espace admin : cookie de session Secure (true en production HTTPS)
SESSION_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_WINDOW=900
ADMIN_RATE_MAX=600
UPLOAD_MAX_BYTES=5242880
